rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function onlyChangedFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // A broadcast notification (see notifications match block) has no single
    // owner, so "marking it read" adds the reader's own uid to a shared
    // `readBy` array instead of flipping a single `isRead` boolean — this
    // guards that a reader can only ever add themselves, never remove or
    // forge another traveler's entry.
    function oldNotificationReadBy() {
      return 'readBy' in resource.data ? resource.data.readBy : [];
    }

    // ---- Data validation helpers ------------------------------------------
    // Defense-in-depth: the app's own form validation already keeps ratings
    // in range and comments a sane length, but these rules stop a malicious
    // or buggy client from writing garbage straight to Firestore regardless.
    function isValidReview() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0
        && request.resource.data.targetType in ['destination', 'restaurant', 'festival']
        && request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 2000
        && isValidVerifiedClaim();
    }

    // A review's "Verified Visit" badge (`verified: true`) must be backed by
    // a real `visited` record for that exact listing — otherwise a direct
    // Firestore SDK write (bypassing the app UI, which only ever sets this
    // from a genuine `UserRepository.hasVisited()` check) could forge the
    // badge on any review for any listing the writer never actually opened.
    function isValidVerifiedClaim() {
      return request.resource.data.verified == false
        || (request.resource.data.verified == true
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/visited/$(request.resource.data.targetType + '_' + request.resource.data.targetId)));
    }

    // A traveler's client-side rating-average recompute (see
    // ReviewRepository._recalculateRating) is trusted to have computed the
    // right number, but the rule itself still has to stop a client from
    // writing garbage straight to a public listing's rating — wrong type or
    // a value outside the 0–5 review scale would otherwise pass silently.
    function isValidRatingUpdate() {
      return request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 5;
    }

    // ReviewRepository.adjustReviewCount writes reviewCount as an atomic
    // +1/-1 (see its doc comment for why: it must never be a plain
    // recompute-and-overwrite, which is exactly the race that used to let
    // two concurrent review writes silently clobber each other's count).
    // Same "trust the shape, not the client's arithmetic" reasoning as
    // isValidSearchTrendIncrement below — a client can only ever nudge the
    // real current count by exactly one in either direction, never set it
    // to an arbitrary number.
    function isValidReviewCountAdjustment() {
      return request.resource.data.reviewCount is int
        && request.resource.data.reviewCount >= 0
        && (request.resource.data.reviewCount == resource.data.reviewCount + 1
            || request.resource.data.reviewCount == resource.data.reviewCount - 1);
    }

    // A traveler-triggered aggregate write is always exactly one of these
    // two shapes (see ReviewRepository) — never both fields in the same
    // write, so `reviewCount` (atomic) can never be clobbered by a
    // possibly-stale `rating` recompute landing in the same update.
    function isValidAggregateUpdate() {
      return (onlyChangedFields(['rating']) && isValidRatingUpdate())
        || (onlyChangedFields(['reviewCount']) && isValidReviewCountAdjustment());
    }

    // A brand-new search_trends/{term} doc must start at count == 1 (the
    // first search of that term) — anything else would let a client seed
    // a fake term straight to the top of "Trending Searches".
    function isValidSearchTrendCreate() {
      return request.resource.data.term is string && request.resource.data.term.size() > 0 && request.resource.data.term.size() <= 100
        && request.resource.data.count == 1
        && request.resource.data.updatedAt is timestamp;
    }

    // A repeat search of an existing term may only bump `count` by exactly
    // 1 per write (never set it directly to an arbitrary number), same
    // "trust the shape, not the client's arithmetic" reasoning as
    // isValidAggregateUpdate above.
    function isValidSearchTrendIncrement() {
      return onlyChangedFields(['count', 'updatedAt'])
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt is timestamp;
    }

    // ---- Admin Portal role helpers ---------------------------------------
    // admin_users/{uid} is the Admin Portal's own account directory
    // (Phase 4), entirely separate from the mobile app's traveler `users`
    // collection — a fundamentally different trust level that shouldn't be
    // mixed into the tight owner-only rules travelers rely on.
    function isAdminAccount() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    function adminData() {
      return get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data;
    }

    function isActiveAdmin() {
      return isAdminAccount() && adminData().status == 'active';
    }

    function hasAdminRole(roles) {
      return isActiveAdmin() && adminData().role in roles;
    }

    // Used only by the reviews match block below, to let a restaurant's
    // owner reply to reviews left on their own listing — mirrors the
    // adminData()/isActiveAdmin() get()-then-compare pattern above.
    function isRestaurantOwner(restaurantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    // An 'lgu' account only manages the one province staged for it at
    // invite time (AdminUser.provinceId); 'admin' has no such restriction.
    // Used everywhere provinces/tourist_spots/festivals are written instead
    // of the bare hasAdminRole(['admin', 'lgu']) those collections used
    // before LGU accounts were province-scoped.
    function canManageProvince(pid) {
      return hasAdminRole(['admin']) || (hasAdminRole(['lgu']) && adminData().provinceId == pid);
    }

    // Invites are keyed by the invited person's lowercased email so a
    // client can look up "is there a pending invite for me" using their own
    // auth token email, with no admin-only read required.
    function invitedEmailKey() {
      return request.auth.token.email.lower();
    }

    function hasPendingInvite() {
      return isSignedIn() && request.auth.token.email is string
        && exists(/databases/$(database)/documents/admin_invites/$(invitedEmailKey()));
    }

    function pendingInviteRole() {
      return get(/databases/$(database)/documents/admin_invites/$(invitedEmailKey())).data.role;
    }

    // Only meaningful for a pending 'lgu' invite — null for admin/
    // businessOwner invites, which never stage a province.
    function pendingInviteProvinceId() {
      return get(/databases/$(database)/documents/admin_invites/$(invitedEmailKey())).data.provinceId;
    }

    // ---- admin_users/{uid} — Admin Portal accounts -----------------------
    // The very first admin account is created out-of-band by a one-time
    // seed script (an IAM-authenticated token, bypassing these rules),
    // since no admin exists yet to satisfy hasAdminRole(['admin']) on that
    // very first write.
    match /admin_users/{uid} {
      allow read: if isOwner(uid) || isActiveAdmin();
      // An admin can directly create any account. Alternatively, a signed-in
      // user with no existing admin_users doc can self-claim their *own*
      // uid — but only using the exact role (and, for 'lgu', the exact
      // province) an admin already staged for their email in admin_invites,
      // and only as an 'active' account, so there's no path to
      // self-granting a role — or a province — nobody offered.
      allow create: if hasAdminRole(['admin'])
                    || (isOwner(uid) && hasPendingInvite()
                        && request.resource.data.role == pendingInviteRole()
                        && request.resource.data.provinceId == pendingInviteProvinceId()
                        && request.resource.data.status == 'active');
      // Any admin account can edit their own name/photo/business name
      // (self-service profile) — status and role changes are a separate,
      // admin-only door (see setStatus/promotions), never bundled with a
      // self-edit.
      // The "never target yourself" check lives here too, not just in the
      // Admin Portal UI (which already hides the menu for your own row) —
      // otherwise a sole remaining admin could still suspend/demote their
      // own account via a bypassed UI or a raw SDK call, with no recovery
      // path short of an out-of-band seed script.
      allow update: if (isOwner(uid) && onlyChangedFields(['name', 'photoUrl', 'businessName']))
                    || (hasAdminRole(['admin']) && onlyChangedFields(['status', 'role']) && !isOwner(uid));
      allow delete: if hasAdminRole(['admin']);
    }

    // ---- admin_invites/{lowercasedEmail} — staged Admin Portal roles -----
    // An admin stages a role for an email address; the invited person (who
    // must already have an ordinary TripNest account under that email)
    // reads it to know an invite exists, then self-claims via admin_users'
    // create rule above. Either side can remove the invite once it's used
    // or no longer wanted.
    match /admin_invites/{email} {
      allow read: if hasAdminRole(['admin']) || (isSignedIn() && invitedEmailKey() == email);
      allow create, update: if hasAdminRole(['admin']);
      allow delete: if hasAdminRole(['admin']) || (isSignedIn() && invitedEmailKey() == email);
    }

    // ---- users/{uid} ----------------------------------------------------
    // Every traveler can read/write only their own profile document and
    // their own recently-viewed history. Admin Portal accounts can also
    // read (never write) for the Users module and dashboard stats.
    // A brand-new profile must match the signed-in identity that's creating
    // it — not just "email is some string" — so a raw SDK call bypassing
    // the app UI can't spoof another traveler's email or write oversized
    // junk fields into a doc other code will trust later (e.g. the review
    // author name shown to every other traveler).
    function isValidNewUserProfile() {
      return request.resource.data.email is string && request.resource.data.email.size() <= 254
        && (request.resource.data.email == '' || request.resource.data.email == request.auth.token.email)
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2048
        && request.resource.data.status == 'active';
    }

    // Only checks the fields actually being touched — an update that
    // doesn't change name/photoUrl at all (e.g. just travelPreferences)
    // shouldn't have to satisfy bounds on fields it isn't writing. Same
    // length caps as isValidNewUserProfile, so a raw SDK write can't do via
    // "edit profile" what create already blocks.
    function isValidUserUpdate() {
      return (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
              || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoUrl'])
              || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2048));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isActiveAdmin();
      allow create: if isOwner(userId) && isValidNewUserProfile();
      // Travelers can update their own profile but never their own
      // `status` — that's the Admin Portal's suspend/activate switch, and
      // an admin (write access here is intentionally limited to just that
      // one field) is the only one who can flip it.
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) && isValidUserUpdate())
                    || (hasAdminRole(['admin']) && onlyChangedFields(['status']));
      // Self-delete is the traveler's own account-deletion flow (Settings ->
      // Delete Account); an admin can also remove an account directly.
      allow delete: if isOwner(userId) || hasAdminRole(['admin']);

      match /recently_viewed/{destinationId} {
        allow read, write: if isOwner(userId);
      }

      // Backs a review's Verified Visit badge (ReviewRepository checks this
      // before stamping `verified` at creation) — same owner-only shape as
      // recently_viewed above.
      match /visited/{visitId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---- Public content: tourist_spots / festivals ----------------------
    // A single doc `get` (an already-known id, e.g. a favorited or
    // itinerary-linked spot) stays open to any signed-in traveler even if
    // that spot has since gone back to draft — matches
    // DestinationRepository/FestivalRepository's getById. A `list`/query —
    // including a batch `getByIds` — must be provably published-only,
    // closing off "browse every draft directly" via a raw Firestore query
    // that skips the app's own `_publishedOnly` filter; admin/lgu roles are
    // exempt since they curate drafts here. tourist_spots is curated
    // catalog content — only Admin/LGU accounts write it, the same
    // stewardship model as provinces. Travelers can still only touch the
    // aggregate rating/reviewCount fields, which ReviewRepository
    // recalculates after a review is added, edited or deleted.
    match /tourist_spots/{spotId} {
      allow get: if isSignedIn();
      // list stays a plain role check (not province-scoped) — a dashboard
      // query across every draft is read-only and not the sensitive
      // operation here; only writes hand curatorial control of a spot to
      // whichever LGU's province it belongs to.
      allow list: if isSignedIn() && (resource.data.status == 'published' || hasAdminRole(['admin', 'lgu']));
      // An LGU can only ever touch a spot that both was and stays in their
      // own province — canManageProvince alone would still let them
      // reassign someone else's spot into their own province by editing
      // provinceId, so the unchanged-provinceId check closes that off too.
      allow update: if (isSignedIn() && isValidAggregateUpdate())
                    || hasAdminRole(['admin'])
                    || (hasAdminRole(['lgu']) && adminData().provinceId == resource.data.provinceId
                        && request.resource.data.provinceId == resource.data.provinceId);
      allow create: if canManageProvince(request.resource.data.provinceId);
      allow delete: if canManageProvince(resource.data.provinceId);
    }

    // ---- restaurants/{id} — mirrored from an approved foodAndDining ------
    // businessOwner listing (see the class doc on Business), never authored
    // directly. `create`/`delete` happen only as a side effect of an admin
    // approving/deleting that business (never a direct traveler or
    // business-owner create) — LGU is deliberately excluded here, unlike
    // tourist_spots/festivals, since restaurant sourcing is fully owner-
    // driven now. The linked owner can keep their own listing's info in
    // sync post-approval, but can never flip `status` themselves (that
    // follows their business's approval state) or touch the aggregate
    // rating/reviewCount.
    match /restaurants/{restaurantId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.status == 'published' || hasAdminRole(['admin']));
      allow create, delete: if hasAdminRole(['admin']);
      allow update: if (isSignedIn() && isValidAggregateUpdate())
                    || hasAdminRole(['admin'])
                    || (hasAdminRole(['businessOwner']) && resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'rating', 'reviewCount', 'ownerId', 'businessId']));
    }

    // Festivals: admin/lgu keep full curatorial control (official,
    // province-run festivals) — same stewardship model as tourist_spots
    // and restaurants above.
    match /festivals/{festivalId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.status == 'published' || hasAdminRole(['admin', 'lgu']));
      allow create: if canManageProvince(request.resource.data.provinceId);
      allow update: if (isSignedIn() && isValidAggregateUpdate())
                    || hasAdminRole(['admin'])
                    || (hasAdminRole(['lgu']) && adminData().provinceId == resource.data.provinceId
                        && request.resource.data.provinceId == resource.data.provinceId);
      allow delete: if canManageProvince(resource.data.provinceId);
    }

    match /travel_tips/{tipId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- Geography: regions / provinces / cities ------------------------
    // Fixed reference data (17 regions, 83 provinces incl. the Metro Manila
    // pseudo-province). Regions are a closed taxonomy, seeded once. Province
    // page content (overview, tips, hotlines, ...) is fillable over time by
    // Admin/LGU Portal accounts; cities are created on demand as content
    // references them, same roles as their parent province.
    match /regions/{regionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /provinces/{provinceId} {
      allow read: if isSignedIn();
      allow create, delete: if hasAdminRole(['admin']);
      // A province document *is* the province — no separate provinceId
      // field to check for tampering, unlike tourist_spots/festivals above.
      allow update: if canManageProvince(provinceId);

      match /cities/{cityId} {
        allow read: if isSignedIn();
        allow create, update, delete: if canManageProvince(provinceId);
      }
    }

    // ---- favorites/{uid}_{type}_{itemId} --------------------------------
    // Admin Portal accounts get read access too, for the "Most Saved
    // Places" dashboard metric — never write.
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isActiveAdmin());
      // The admin branch backs deleting a listing's now-dangling favorites
      // when an admin removes it (see AdminBusinessListScreen) — otherwise
      // those favorite docs point at an id that no longer resolves to
      // anything, permanently.
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isActiveAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ---- trip_photos/{id} — private "My Photos" travel journal -----------
    // Same shape as favorites above, minus the admin-read exception: no
    // admin/dashboard use case for a personal photo journal.
    match /trip_photos/{photoId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ---- saved_itineraries/{id} — owner + shared-trip collaborators ------
    // Admin Portal accounts get read access too, for the Analytics
    // "Saved Trips" trend — never write.
    //
    // A collaborator (added via a share-code "join") can read the trip,
    // check off the shared packing list, and join/leave — but never touch
    // the itinerary content, title, or budget; that stays owner-only.
    function isCollaborator() {
      return ('collaboratorIds' in resource.data) && request.auth.uid in resource.data.collaboratorIds;
    }

    function oldCollaboratorIds() {
      return 'collaboratorIds' in resource.data ? resource.data.collaboratorIds : [];
    }

    function oldMemberNames() {
      return 'memberNames' in resource.data ? resource.data.memberNames : {};
    }

    // A self-join/self-leave write may only ever touch the caller's own
    // key in memberNames — otherwise a joiner could deface the display
    // name stored for every other member of the trip.
    function onlyOwnMemberNameChanged() {
      return !('memberNames' in request.resource.data)
        || oldMemberNames().diff(request.resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /saved_itineraries/{itineraryId} {
      // Split from a single `read` on purpose: joining a shared trip means
      // looking it up by its share code (the doc id) BEFORE the joiner is
      // an owner/collaborator, so a single-document `get` is allowed for
      // any signed-in traveler — the 20-character random id is itself the
      // invitation, the same "anyone with the link" model the `update`
      // rule below already uses for the join write itself. `list` (a
      // collection query — "My Trips") stays restricted, so this can never
      // be used to enumerate/browse every trip in the app.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isCollaborator() || hasAdminRole(['admin']));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Owner: full control.
        resource.data.userId == request.auth.uid
        // Self-join: add only yourself to collaboratorIds — every existing
        // collaborator must still be present (a joiner can't evict anyone)
        // — and touch only your own memberNames entry, nothing else.
        || (
          onlyChangedFields(['collaboratorIds', 'memberNames'])
          && request.resource.data.collaboratorIds.hasOnly(oldCollaboratorIds().concat([request.auth.uid]))
          && oldCollaboratorIds().hasOnly(request.resource.data.collaboratorIds)
          && onlyOwnMemberNameChanged()
        )
        // Self-leave: remove only yourself from collaboratorIds — nobody
        // else's membership may change — and touch only your own
        // memberNames entry (its removal), nothing else.
        || (
          onlyChangedFields(['collaboratorIds', 'memberNames'])
          && isCollaborator()
          && oldCollaboratorIds().hasOnly(request.resource.data.collaboratorIds.concat([request.auth.uid]))
          && request.resource.data.collaboratorIds.hasOnly(oldCollaboratorIds())
          && onlyOwnMemberNameChanged()
        )
        // Existing collaborator: may check off / edit the shared packing list only.
        || (isCollaborator() && onlyChangedFields(['packingItems']))
      );

      match /expenses/{expenseId} {
        function isTripOwner() {
          return get(/databases/$(database)/documents/saved_itineraries/$(itineraryId)).data.userId == request.auth.uid;
        }

        function isTripCollaborator() {
          return ('collaboratorIds' in get(/databases/$(database)/documents/saved_itineraries/$(itineraryId)).data)
            && request.auth.uid in get(/databases/$(database)/documents/saved_itineraries/$(itineraryId)).data.collaboratorIds;
        }

        // Trusts the app's own split-math (ExpenseSplit) the same way
        // reviews/aggregates trust their own client-side recompute — this
        // is just the shape/sanity backstop against a raw write straight to
        // Firestore, not full business-logic validation.
        function isValidExpense() {
          return request.resource.data.loggedBy == request.auth.uid
            && request.resource.data.amount is number
            && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
            && request.resource.data.category is string && request.resource.data.category.size() > 0
            && request.resource.data.note is string && request.resource.data.note.size() <= 500;
        }

        allow read: if isSignedIn() && (isTripOwner() || isTripCollaborator());
        allow create: if isSignedIn() && (isTripOwner() || isTripCollaborator()) && isValidExpense();
        // Any collaborator could edit or delete ANY expense before —
        // including ones someone else logged — with nothing server-side
        // checking who actually logged it. Now only the trip owner (full
        // control, same as everywhere else on this doc) or whoever logged
        // that specific expense can touch it, and an edit can't reassign
        // `loggedBy` to dodge that check.
        allow update: if isSignedIn() && (isTripOwner() || resource.data.loggedBy == request.auth.uid)
                      && request.resource.data.loggedBy == resource.data.loggedBy
                      && isValidExpense();
        allow delete: if isSignedIn() && (isTripOwner() || resource.data.loggedBy == request.auth.uid);
      }
    }

    // ---- businesses/{id} — Business Owner submissions, admin-verified ---
    // A Business Owner can create and edit only their own listing's info
    // fields (never their own `status`/`rejectionReason` — that's the
    // Admin Portal's approve/reject/suspend workflow). An admin can read
    // every business, and can only touch `status`/`rejectionReason`,
    // never rewrite someone's business info themselves. Any signed-in
    // traveler can read an 'approved' listing (the "Local Businesses"
    // province section) — pending/rejected/suspended stay visible only to
    // their owner or an admin.
    match /businesses/{businessId} {
      allow read: if isSignedIn() && (
        resource.data.status == 'approved' || resource.data.ownerId == request.auth.uid || hasAdminRole(['admin'])
      );
      allow create: if hasAdminRole(['businessOwner'])
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // The owner can edit their info freely, and additionally — only as
      // part of the same write — move their own listing from rejected
      // back to pending (fix-and-resubmit). They can never set 'approved'
      // or 'suspended' themselves, never touch ownerId, and never link
      // themselves to a restaurant doc (that's admin/system-managed —
      // see RestaurantRepository.createFromBusiness).
      allow update: if (hasAdminRole(['businessOwner']) && resource.data.ownerId == request.auth.uid
                      && request.resource.data.ownerId == request.auth.uid && (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'rejectionReason', 'ownerId', 'restaurantId'])
                        || (resource.data.status == 'rejected' && request.resource.data.status == 'pending' && request.resource.data.rejectionReason == '')
                      ))
                    // Admin: status/rejectionReason for approve/reject/suspend, and
                    // restaurantId the one time a foodAndDining listing is first
                    // approved (see AdminBusinessListScreen._syncRestaurantBeforeApproval).
                    || (hasAdminRole(['admin']) && onlyChangedFields(['status', 'rejectionReason', 'restaurantId']));
      allow delete: if hasAdminRole(['admin']);
    }

    // ---- reviews/{id} — public read, owner-write, admin-moderated -------
    // Admins can only flip `isHidden` (moderation), never rewrite someone
    // else's rating/comment; delete is available to the owner or an admin.
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidReview();
      // An owner's edit must still pass validation and can't repoint the
      // review at a different listing or targetType.
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid && isValidReview()
                        && request.resource.data.targetId == resource.data.targetId
                        && request.resource.data.targetType == resource.data.targetType)
                    || (hasAdminRole(['admin']) && onlyChangedFields(['isHidden']))
                    // A restaurant owner replying to a review left on their
                    // own listing — never able to touch the review's own
                    // rating/comment/photos, only the reply pair.
                    || (resource.data.targetType == 'restaurant'
                        && isRestaurantOwner(resource.data.targetId)
                        && onlyChangedFields(['ownerReply', 'ownerRepliedAt']));
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || hasAdminRole(['admin']);
    }

    // ---- review_reports/{id} — traveler flags, admin-only moderation ----
    // A traveler can file a report on any review (immutable once filed —
    // no update, so a report can't be edited after the fact); only an
    // admin can read the queue or clear a report once handled. The actual
    // hide/restore action still happens on the `reviews` doc itself via the
    // existing `isHidden` rule above.
    match /review_reports/{reportId} {
      allow read: if hasAdminRole(['admin']) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.reviewId is string && request.resource.data.reviewId.size() > 0
                    && request.resource.data.reason is string && request.resource.data.reason.size() > 0
                    && request.resource.data.reason.size() <= 500;
      allow update: if false;
      allow delete: if hasAdminRole(['admin']);
    }

    // ---- notifications/{id} ----------------------------------------------
    // A doc with an empty userId is a broadcast sent to every traveler.
    // Marking a broadcast notification "read" is a simplification for this
    // phase (no per-user read-state doc yet), so any signed-in user may
    // flip `isRead` on any notification — nothing else is writable here.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == '');
      // A personal notification's isRead can only be flipped by the
      // traveler it belongs to. A broadcast (userId == '') has no single
      // owner — read state there is per-reader, so a signed-in traveler may
      // only append their own uid to `readBy`, never touch anyone else's.
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid && onlyChangedFields(['isRead']))
                    || (isSignedIn() && resource.data.userId == '' && onlyChangedFields(['readBy'])
                        && request.resource.data.readBy.hasOnly(oldNotificationReadBy().concat([request.auth.uid]))
                        && oldNotificationReadBy().hasOnly(request.resource.data.readBy))
                    || hasAdminRole(['admin', 'lgu']);
      // Broadcasts (empty userId) stay admin+lgu, matching the "Send
      // Announcement" tile both roles see. A personal notification (e.g.
      // "your business listing was approved/rejected/suspended") is
      // admin-only, since only admin ever changes a business's status.
      allow create: if (hasAdminRole(['admin', 'lgu']) && request.resource.data.userId == '')
                    || (hasAdminRole(['admin']) && request.resource.data.userId is string && request.resource.data.userId != '');
      // A traveler may delete their own personal notifications (account
      // deletion cleanup); broadcasts stay admin/lgu-only, same as create.
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || hasAdminRole(['admin', 'lgu']);
    }

    // ---- rate_limits/{id} --------------------------------------------------
    // Written only by Cloud Functions via the Admin SDK, which bypasses
    // these rules entirely — this is just an explicit deny so no client
    // (not even a signed-in one) can read its own counter to figure out how
    // close it is to a cap, or write to it directly to reset one.
    match /rate_limits/{id} {
      allow read, write: if false;
    }

    // ---- search_trends/{term} ----------------------------------------------
    // One doc per normalized search term, incremented directly by the
    // client (via SearchTrendRepository) every time someone searches it —
    // same trust model as isValidAggregateUpdate above: a signed-in
    // traveler can nudge a real term's count, but never forge the shape of
    // the write itself (see isValidSearchTrendCreate/Increment).
    match /search_trends/{term} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidSearchTrendCreate();
      allow update: if isSignedIn() && isValidSearchTrendIncrement();
      allow delete: if hasAdminRole(['admin']);
    }
  }
}
